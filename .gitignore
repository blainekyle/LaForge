# Build artifacts
bin/
obj/
out/
*.pdb
*.user

# Heavy runtime / VM images & large APK/bridge binaries (preserve directory structure and forged configs)
runtime/*
!runtime/.gitkeep
bridge/*
!bridge/.gitkeep
samples/*.apk
dist/*/payload.apk
dist/*/bridge/*

# Temporary / OS files
.DS_Store
Thumbs.db
*.tmp
*.log

# local build/test scratch
__pycache__/
publish_out/build/
publish/launcher/
tests/test_assets/root_explorer.apk
tests/test_assets/**/.gradle/
tests/test_assets/**/build/
tools/
src/LaForge.VendingStub/rootexplorer_shim/
src/LaForge.VendingStub/build/shim*
