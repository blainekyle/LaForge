# Build artifacts
bin/
obj/
out/
*.pdb
*.user

# Heavy runtime / VM images & large APK/bridge binaries (preserve directory structure and forged configs)
runtime/*
!runtime/.gitkeep
bridge/*
!bridge/.gitkeep
samples/*.apk
dist/*/payload.apk
dist/*/bridge/*
dist/com.*
dist/fr.*
dist/omnibeat.app/

# Temporary / OS files
.DS_Store
Thumbs.db
*.tmp
*.log

# local build/test scratch
__pycache__/
publish_out/build/
publish/
LaForgeSetup.exe
dist/LaForgeSetup.exe
*.zip
src/LaForge.Installer/installer_payload.zip
tests/test_assets/root_explorer.apk
