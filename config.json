{
  "app": {
    "title": "LaForge Standalone App",
    "apk_path": "./payload.apk",
    "package_name": "com.citrix.Receiver",
    "activity_name": "com.citrix.client.LauncherActivity"
  },
  "runtime": {
    "emulator_path": "emulator",
    "adb_path": "adb",
    "avd_name": "LaForge_x86_64_API34",
    "snapshot": "default_boot",
    "gpu_mode": "host",
    "whpx": true,
    "headless": true,
    "boot_timeout_sec": 60
  },
  "display": {
    "scrcpy_path": "bridge/scrcpy.exe",
    "render_driver": "direct3d",
    "window": {
      "x": 100,
      "y": 100,
      "width": 1280,
      "height": 720,
      "borderless": true,
      "always_on_top": false,
      "fullscreen": false
    },
    "vsync": true,
    "max_fps": 60,
    "stay_awake": true
  },
  "relays": {
    "remote_staging_dir": "/sdcard/Download",
    "associations": {
      ".ica": {
        "mime_type": "application/x-ica",
        "action": "android.intent.action.VIEW"
      },
      ".rdp": {
        "mime_type": "application/x-rdp",
        "action": "android.intent.action.VIEW"
      },
      ".pdf": {
        "mime_type": "application/pdf",
        "action": "android.intent.action.VIEW"
      }
    }
  }
}
