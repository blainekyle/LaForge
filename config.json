{
  "app": {
    "title": "LaForge Standalone App",
    "apk_path": "./payload.apk",
    "package_name": "org.fossify.filemanager",
    "activity_name": "org.fossify.filemanager.activities.MainActivity"
  },
  "runtime": {
    "emulator_path": "emulator",
    "adb_path": "adb",
    "avd_name": "LaForge_x86_64_API34",
    "snapshot": "default_boot",
    "gpu_mode": "host",
    "whpx": true,
    "headless": true,
    "boot_timeout_sec": 60
  },
  "display": {
    "scrcpy_path": "bridge/scrcpy.exe",
    "render_driver": "direct3d",
    "window": {
      "x": 100,
      "y": 100,
      "width": 1280,
      "height": 720,
      "borderless": true,
      "always_on_top": false,
      "fullscreen": false
    },
    "vsync": true,
    "max_fps": 60,
    "stay_awake": true
  },
  "storage": {
    "enable_host_mount": true,
    "host_folder_path": "%LOCALAPPDATA%\\LaForge\\HOST",
    "guest_mount_path": "/sdcard/HOST",
    "create_shortcut": true
  },
  "relays": {
    "remote_staging_dir": "/sdcard/Download",
    "associations": {
      ".pdf": {
        "mime_type": "application/pdf",
        "action": "android.intent.action.VIEW"
      },
      ".txt": {
        "mime_type": "text/plain",
        "action": "android.intent.action.VIEW"
      }
    }
  },
  "gms_interop": {
    "inject_microg": true,
    "inject_vending_stub": true,
    "microg_apk_path": "runtime/gms/microg-gms-core.apk",
    "vending_stub_apk_path": "runtime/gms/vending-licensing-stub.apk",
    "excluded_packages": [
      "com.google.android.gms",
      "com.mgoogle.android.gms",
      "org.microg.gms",
      "org.microg.gms.droidguard",
      "app.revanced.android.gms",
      "com.google.android.gsf",
      "com.mgoogle.android.gsf",
      "com.android.vending"
    ]
  }
}
