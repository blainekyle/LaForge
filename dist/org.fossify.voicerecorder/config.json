{
  "app": {
    "title": "LaForge - Fossify Voicerecorder (v1.7.1)",
    "apk_path": "./payload.apk",
    "package_name": "org.fossify.voicerecorder",
    "activity_name": "org.fossify.voicerecorder.activities.SplashActivity.Green"
  },
  "runtime": {
    "emulator_path": "emulator",
    "adb_path": "adb",
    "avd_name": "LaForge_x86_64_API34",
    "snapshot": "default_boot",
    "gpu_mode": "host",
    "whpx": true,
    "headless": true,
    "boot_timeout_sec": 60
  },
  "display": {
    "scrcpy_path": "bridge/scrcpy.exe",
    "render_driver": "direct3d",
    "window": {
      "x": 140,
      "y": 140,
      "width": 1280,
      "height": 720,
      "borderless": false,
      "always_on_top": false,
      "fullscreen": false
    },
    "vsync": true,
    "max_fps": 60,
    "stay_awake": true
  },
  "relays": {
    "remote_staging_dir": "/sdcard/Download",
    "associations": {
      ".mp3": {
        "mime_type": "audio/mpeg",
        "action": "android.intent.action.VIEW"
      },
      ".wav": {
        "mime_type": "audio/wav",
        "action": "android.intent.action.VIEW"
      },
      ".m4a": {
        "mime_type": "audio/mp4",
        "action": "android.intent.action.VIEW"
      },
      ".ogg": {
        "mime_type": "audio/ogg",
        "action": "android.intent.action.VIEW"
      },
      ".flac": {
        "mime_type": "audio/flac",
        "action": "android.intent.action.VIEW"
      }
    }
  }
}