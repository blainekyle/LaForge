{
  "app": {
    "title": "LaForge - Fossify Gallery (v1.13.1)",
    "apk_path": "./payload.apk",
    "package_name": "org.fossify.gallery",
    "activity_name": "org.fossify.gallery.activities.SplashActivity.Green"
  },
  "runtime": {
    "emulator_path": "emulator",
    "adb_path": "adb",
    "avd_name": "LaForge_x86_64_API34",
    "snapshot": "default_boot",
    "gpu_mode": "host",
    "whpx": true,
    "headless": true,
    "boot_timeout_sec": 60
  },
  "display": {
    "scrcpy_path": "bridge/scrcpy.exe",
    "render_driver": "direct3d",
    "window": {
      "x": 100,
      "y": 100,
      "width": 1280,
      "height": 720,
      "borderless": true,
      "always_on_top": false,
      "fullscreen": false
    },
    "vsync": true,
    "max_fps": 60,
    "stay_awake": true
  },
  "relays": {
    "remote_staging_dir": "/sdcard/Download",
    "associations": {
      ".png": {
        "mime_type": "image/png",
        "action": "android.intent.action.VIEW"
      },
      ".jpg": {
        "mime_type": "image/jpeg",
        "action": "android.intent.action.VIEW"
      },
      ".jpeg": {
        "mime_type": "image/jpeg",
        "action": "android.intent.action.VIEW"
      },
      ".webp": {
        "mime_type": "image/webp",
        "action": "android.intent.action.VIEW"
      },
      ".mp4": {
        "mime_type": "video/mp4",
        "action": "android.intent.action.VIEW"
      },
      ".mkv": {
        "mime_type": "video/x-matroska",
        "action": "android.intent.action.VIEW"
      }
    }
  }
}